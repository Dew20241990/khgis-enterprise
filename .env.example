# Copy to .env.local (never commit real values). All variables are optional.

# Optional Supabase (GIS layer cache + audit-log writes). Placeholders only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo login panel and built-in demo accounts. Set to "false" to hide them.
# NOTE: login is a client-side demo gate, NOT server-side authentication.
VITE_DEMO_MODE=true

# Optional vehicle telemetry endpoint (JSON). When empty, the tracking page
# shows clearly labelled simulated DEMO positions.
VITE_TELEMETRY_URL=
